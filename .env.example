# Local model and HF caches. Set these before importing model packages.
HF_HOME=./models/huggingface
TORCH_HOME=./models/torch
XDG_CACHE_HOME=./models/cache
ANPR_DEVICE=cuda:0
ANPR_OFFLINE=0
ANPR_OUTPUT_DIR=./output
ANPR_LOG_LEVEL=INFO

# Optional second OCR engine, installed into a separate Python environment
# ANPR_PADDLE_PYTHON=./.venv-paddle/bin/python
